{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Envelope",
  "description": "The envelope of every published message.",
  "type": "object",
  "properties": {
    "body": {
      "$ref": "#/$defs/Scene"
    },
    "event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_event_seq": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "observed_at": {
      "description": "Source time of what is claimed: without a new sample, that of the last\nobserved one.",
      "$ref": "#/$defs/SampleRef"
    },
    "profile": {
      "$ref": "#/$defs/Profile"
    },
    "published_at_ms": {
      "description": "Wall clock; set by publishing, never by the core.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "schema": {
      "$ref": "#/$defs/SchemaId"
    },
    "seq": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "timing": {
      "anyOf": [
        {
          "$ref": "#/$defs/Timing"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "source",
    "seq",
    "observed_at",
    "published_at_ms",
    "profile",
    "body"
  ],
  "$defs": {
    "Attention": {
      "description": "What was looked at during the turn, in order.",
      "type": "object",
      "properties": {
        "looks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Look"
          }
        }
      },
      "required": [
        "looks"
      ]
    },
    "Bed": {
      "type": "object",
      "properties": {
        "held": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Held"
          }
        },
        "seen": {
          "description": "Occupants seen in the bed, in the stable count. It is belief: if the\nscene did not come from an observation, `republished` says so.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "since": {
          "anyOf": [
            {
              "$ref": "#/$defs/SampleRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/BedState"
        },
        "unexplained": {
          "description": "Stable bodies in the bed that are not occupants: they appeared without\nanyone coming from the floor. They do not count in the room.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "state",
        "seen",
        "held",
        "unexplained"
      ]
    },
    "BedState": {
      "description": "Is someone in the bed?",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "empty"
          ]
        },
        {
          "description": "At least one visible occupant in the bed's stable count.",
          "type": "string",
          "const": "seen"
        },
        {
          "description": "Nobody seen, with retained occupants.",
          "type": "string",
          "const": "held"
        },
        {
          "description": "The bed geometry does not apply to the image.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "BodiesEvidence": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BodySeen"
          }
        },
        "status": {
          "$ref": "#/$defs/BodiesStatus"
        }
      },
      "required": [
        "status",
        "items"
      ]
    },
    "BodiesStatus": {
      "type": "string",
      "enum": [
        "seen",
        "unzoned",
        "unavailable"
      ]
    },
    "BodyPoint": {
      "description": "A published pose point: where it is, how confident the model is and, if\nmeasured, its depth on the depth model's scale, which is relative and not\nmetres. An unmeasured point carries `depth: null`.",
      "type": "object",
      "properties": {
        "depth": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/Joint"
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "type": "number",
          "format": "float"
        },
        "x": {
          "type": "number",
          "format": "float"
        },
        "y": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "x",
        "y",
        "score"
      ]
    },
    "BodySeen": {
      "type": "object",
      "properties": {
        "bbox": {
          "$ref": "#/$defs/Rect"
        },
        "confidence": {
          "type": "number",
          "format": "float"
        },
        "near_bed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/BodySource"
        },
        "zone": {
          "anyOf": [
            {
              "$ref": "#/$defs/Zone"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "bbox",
        "confidence",
        "source"
      ]
    },
    "BodySource": {
      "description": "Which detector the admitted body came from.",
      "type": "string",
      "enum": [
        "primary",
        "reinforcement"
      ]
    },
    "Build": {
      "type": "object",
      "properties": {
        "git": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "git"
      ]
    },
    "Calibration": {
      "description": "The learned bed depth and the sample it came from.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "unavailable"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reference_m": {
              "type": "number",
              "format": "float"
            },
            "since": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SampleRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "type": "string",
              "const": "complete"
            }
          },
          "required": [
            "status",
            "reference_m"
          ]
        }
      ]
    },
    "Counts": {
      "description": "What is seen in each zone, stabilized or yet to stabilize.",
      "type": "object",
      "properties": {
        "bed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "floor": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "floor",
        "bed"
      ]
    },
    "Evidence": {
      "description": "What was admitted in this sample, apart from the stabilized belief.",
      "type": "object",
      "properties": {
        "bodies": {
          "$ref": "#/$defs/BodiesEvidence"
        },
        "faces": {
          "$ref": "#/$defs/FacesEvidence"
        }
      },
      "required": [
        "bodies",
        "faces"
      ]
    },
    "FaceSeen": {
      "type": "object",
      "properties": {
        "bbox": {
          "$ref": "#/$defs/Rect"
        },
        "confidence": {
          "type": "number",
          "format": "float"
        },
        "on_subject": {
          "type": "boolean"
        }
      },
      "required": [
        "bbox",
        "confidence",
        "on_subject"
      ]
    },
    "FacesEvidence": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FaceSeen"
          }
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkipReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/FacesStatus"
        }
      },
      "required": [
        "status",
        "items"
      ]
    },
    "FacesStatus": {
      "type": "string",
      "enum": [
        "ok",
        "empty",
        "failed",
        "skipped"
      ]
    },
    "FailureKind": {
      "oneOf": [
        {
          "description": "The shell could not complete the probe (shutdown).",
          "type": "string",
          "const": "cancelled"
        },
        {
          "description": "The sense ran and failed (model or backend error).",
          "type": "string",
          "const": "model"
        }
      ]
    },
    "Floor": {
      "description": "Off the bed, no longer being seen is leaving the room: nobody is retained.",
      "type": "object",
      "properties": {
        "seen": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "seen"
      ]
    },
    "FrameInfo": {
      "description": "Size of a decoded frame.",
      "type": "object",
      "properties": {
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "Geometry": {
      "description": "Whether the delimited bed matches the incoming image.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "valid"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "The resolution is not the declared one: \"in bed\" cannot be claimed.",
          "type": "object",
          "properties": {
            "actual": {
              "$ref": "#/$defs/FrameInfo"
            },
            "declared": {
              "$ref": "#/$defs/FrameInfo"
            },
            "type": {
              "type": "string",
              "const": "invalid"
            }
          },
          "required": [
            "type",
            "declared",
            "actual"
          ]
        }
      ]
    },
    "Held": {
      "description": "Someone who stopped being seen in bed without an observed exit.",
      "type": "object",
      "properties": {
        "bbox": {
          "$ref": "#/$defs/Rect"
        },
        "last_seen": {
          "description": "The last sample they were seen in.",
          "$ref": "#/$defs/SampleRef"
        }
      },
      "required": [
        "bbox",
        "last_seen"
      ]
    },
    "Joint": {
      "description": "A body joint per COCO-17: the keypoint's index in the pose gives its\nname.",
      "type": "string",
      "enum": [
        "nose",
        "left_eye",
        "right_eye",
        "left_ear",
        "right_ear",
        "left_shoulder",
        "right_shoulder",
        "left_elbow",
        "right_elbow",
        "left_wrist",
        "right_wrist",
        "left_hip",
        "right_hip",
        "left_knee",
        "right_knee",
        "left_ankle",
        "right_ankle"
      ]
    },
    "LayerRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "Look": {
      "description": "An entry of attention's ledger (rule 12): what was decided to look at or\nnot, and what happened.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/LookKind"
        },
        "outcome": {
          "$ref": "#/$defs/LookOutcome"
        }
      },
      "required": [
        "kind",
        "outcome"
      ]
    },
    "LookKind": {
      "description": "What was asked to be looked at.",
      "oneOf": [
        {
          "description": "The main person detector.",
          "type": "string",
          "const": "detect"
        },
        {
          "description": "The face detector.",
          "type": "string",
          "const": "faces"
        },
        {
          "description": "The finer detector over the bed, when the subject is lost.",
          "type": "string",
          "const": "reinforce"
        },
        {
          "description": "The subject's pose.",
          "type": "string",
          "const": "pose"
        },
        {
          "description": "The depth at image points.",
          "type": "string",
          "const": "depth"
        },
        {
          "description": "The depth of the empty bed, to learn it.",
          "type": "string",
          "const": "calibrate"
        }
      ]
    },
    "LookOutcome": {
      "oneOf": [
        {
          "description": "A look was requested.",
          "type": "object",
          "properties": {
            "region": {
              "description": "`None`: the whole frame.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Rect"
                },
                {
                  "type": "null"
                }
              ]
            },
            "result": {
              "$ref": "#/$defs/LookResult"
            },
            "spent_ms": {
              "description": "What the shell measured; the core only records it (rule 9).",
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "asked"
            }
          },
          "required": [
            "type",
            "result",
            "spent_ms"
          ]
        },
        {
          "description": "It was decided not to look, with a reason.",
          "type": "object",
          "properties": {
            "reason": {
              "$ref": "#/$defs/SkipReason"
            },
            "type": {
              "type": "string",
              "const": "skipped"
            }
          },
          "required": [
            "type",
            "reason"
          ]
        }
      ]
    },
    "LookResult": {
      "description": "What a look returned.",
      "oneOf": [
        {
          "description": "The sense read: how many candidates, and why those that did not count\nwere discarded.",
          "type": "object",
          "properties": {
            "candidates": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "rejected": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Rejected"
              }
            },
            "type": {
              "type": "string",
              "const": "read"
            }
          },
          "required": [
            "type",
            "candidates",
            "rejected"
          ]
        },
        {
          "description": "The sense failed: it proves nothing (rule 1).",
          "type": "object",
          "properties": {
            "failure": {
              "$ref": "#/$defs/FailureKind"
            },
            "type": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "type",
            "failure"
          ]
        }
      ]
    },
    "Lying": {
      "description": "What the second level concludes from the pose over the bed plane, with that\npose's provenance.",
      "type": "object",
      "properties": {
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "state": {
          "$ref": "#/$defs/LyingState"
        }
      },
      "required": [
        "state",
        "provenance"
      ]
    },
    "LyingState": {
      "description": "Is the subject truly lying down? Second level: it changes no count.",
      "oneOf": [
        {
          "description": "Torso, hips, most keypoints and the visible feet inside the bed.",
          "type": "string",
          "const": "confirmed"
        },
        {
          "description": "Torso, hips and most keypoints inside; the feet are not visible.",
          "type": "string",
          "const": "assumed"
        },
        {
          "description": "The torso, the hips, most keypoints or a visible foot outside the bed.",
          "type": "string",
          "const": "no"
        },
        {
          "description": "The torso or the hips are not visible.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "MapState": {
      "description": "What is published of the static world.",
      "type": "object",
      "properties": {
        "bed": {
          "$ref": "#/$defs/Quad"
        },
        "calibration": {
          "$ref": "#/$defs/Calibration"
        },
        "geometry": {
          "$ref": "#/$defs/Geometry"
        },
        "headboard": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rect"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "geometry",
        "bed",
        "calibration"
      ]
    },
    "Pending": {
      "description": "A new count that has not stabilized yet.",
      "type": "object",
      "properties": {
        "counts": {
          "$ref": "#/$defs/Counts"
        },
        "duration": {
          "description": "Source seconds it has held, against the required dwell.",
          "$ref": "#/$defs/Progress"
        }
      },
      "required": [
        "counts",
        "duration"
      ]
    },
    "Point": {
      "description": "A point on the image plane.",
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "float"
        },
        "y": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "Pose": {
      "description": "The subject's pose, with its own provenance (rule 2).",
      "type": "object",
      "properties": {
        "keypoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BodyPoint"
          }
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "keypoints",
        "provenance"
      ]
    },
    "Posture": {
      "description": "The published posture, with its evidence on the depth model's (relative)\nscale and the pose's provenance.",
      "type": "object",
      "properties": {
        "disparity": {
          "description": "`(upper − lower) / mean`: relative, without scale.",
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "lower": {
          "description": "Median of the measured hips and ankles.",
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "state": {
          "$ref": "#/$defs/PostureState"
        },
        "upper": {
          "description": "Median of the measured head and shoulders.",
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        }
      },
      "required": [
        "state",
        "provenance"
      ]
    },
    "PostureState": {
      "description": "The posture by how head, torso and hips are ordered in depth.\nMonocular depth separates lying from upright by the magnitude of the\ndisparity, not by its sign (measured on real nights): sitting and standing are not\ndistinguished and are published together.",
      "oneOf": [
        {
          "description": "The hips clearly closer to the camera than the head and shoulders.",
          "type": "string",
          "const": "lying"
        },
        {
          "description": "Sitting, getting up or standing. Also reads `sitting` and `standing`,\nthe values published before 904-5, so nights recorded with them can be\nreplayed; publishes only `upright`.",
          "type": "string",
          "const": "upright"
        },
        {
          "description": "One of the two groups has no measured keypoints.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "Profile": {
      "type": "object",
      "properties": {
        "camera": {
          "anyOf": [
            {
              "$ref": "#/$defs/LayerRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "hash": {
          "$ref": "#/$defs/ProfileHash"
        },
        "resident": {
          "anyOf": [
            {
              "$ref": "#/$defs/LayerRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "senses": {
          "description": "What each configured sense looks with. `hash` already covers them; this\nnames them for whoever watches, as in v2. Empty if the shell does not\nreport them.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SenseProfile"
          }
        }
      },
      "required": [
        "hash"
      ]
    },
    "ProfileHash": {
      "description": "Hash of the effective policy the engine ran with.",
      "type": "string"
    },
    "Progress": {
      "description": "A quantity reached against the one required.",
      "type": "object",
      "properties": {
        "have": {
          "type": "number",
          "format": "double"
        },
        "need": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "have",
        "need"
      ]
    },
    "Provenance": {
      "description": "Where a claim comes from (rule 2).",
      "oneOf": [
        {
          "description": "Observed in this sample.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "current"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Observed earlier and retained without a current observation.",
          "type": "object",
          "properties": {
            "since": {
              "$ref": "#/$defs/SampleRef"
            },
            "type": {
              "type": "string",
              "const": "retained"
            }
          },
          "required": [
            "type",
            "since"
          ]
        },
        {
          "description": "Computed earlier and still valid because the subject did not move.",
          "type": "object",
          "properties": {
            "since": {
              "$ref": "#/$defs/SampleRef"
            },
            "type": {
              "type": "string",
              "const": "stable"
            }
          },
          "required": [
            "type",
            "since"
          ]
        }
      ]
    },
    "Quad": {
      "description": "A quadrilateral: the bed seen in perspective.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Point"
      },
      "maxItems": 4,
      "minItems": 4
    },
    "Rect": {
      "description": "An axis-aligned rectangle: top-left and bottom-right corners.",
      "type": "object",
      "properties": {
        "x0": {
          "type": "number",
          "format": "float"
        },
        "x1": {
          "type": "number",
          "format": "float"
        },
        "y0": {
          "type": "number",
          "format": "float"
        },
        "y1": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ]
    },
    "RejectReason": {
      "description": "Why a candidate did not count as evidence.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "not_person",
            "low_confidence"
          ]
        },
        {
          "description": "Outside the region where the look was requested.",
          "type": "string",
          "const": "outside_region"
        }
      ]
    },
    "Rejected": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "reason": {
          "$ref": "#/$defs/RejectReason"
        }
      },
      "required": [
        "reason",
        "count"
      ]
    },
    "RepublishReason": {
      "description": "Why the scene is republished without a new observation.",
      "oneOf": [
        {
          "description": "The sample did not decode.",
          "type": "string",
          "const": "decode_failed"
        },
        {
          "description": "The decoder produced no image.",
          "type": "string",
          "const": "decode_empty"
        },
        {
          "description": "The sensor state changed.",
          "type": "string",
          "const": "sensor"
        },
        {
          "description": "The main detector failed: the belief is that of the last observation.",
          "type": "string",
          "const": "detect_failed"
        }
      ]
    },
    "Republished": {
      "description": "A republished scene: what happened and when what it claims is from.",
      "type": "object",
      "properties": {
        "observed_at": {
          "description": "The last observed sample; `None` if there has been none yet.",
          "anyOf": [
            {
              "$ref": "#/$defs/SampleRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "$ref": "#/$defs/RepublishReason"
        }
      },
      "required": [
        "reason"
      ]
    },
    "Room": {
      "description": "The room: seen and retained occupants of both zones.",
      "type": "object",
      "properties": {
        "occupants": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pending": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pending"
            },
            {
              "type": "null"
            }
          ]
        },
        "since": {
          "anyOf": [
            {
              "$ref": "#/$defs/SampleRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/RoomState"
        }
      },
      "required": [
        "state",
        "occupants"
      ]
    },
    "RoomState": {
      "description": "How many people are in the room.",
      "type": "string",
      "enum": [
        "empty",
        "one",
        "several"
      ]
    },
    "SampleRef": {
      "description": "Which sample and when, in source time. It is the domain's only clock\n(rule 9).",
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "session": {
          "$ref": "#/$defs/SessionId"
        },
        "source_secs": {
          "$ref": "#/$defs/SourceSecs"
        }
      },
      "required": [
        "session",
        "sequence",
        "source_secs"
      ]
    },
    "Scene": {
      "description": "The scene of one sample.",
      "type": "object",
      "properties": {
        "attention": {
          "$ref": "#/$defs/Attention"
        },
        "bed": {
          "$ref": "#/$defs/Bed"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "floor": {
          "$ref": "#/$defs/Floor"
        },
        "frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "map": {
          "$ref": "#/$defs/MapState"
        },
        "republished": {
          "description": "Present only if this scene does not come from a new observation (P-5).",
          "anyOf": [
            {
              "$ref": "#/$defs/Republished"
            },
            {
              "type": "null"
            }
          ]
        },
        "room": {
          "$ref": "#/$defs/Room"
        },
        "sensor": {
          "$ref": "#/$defs/SensorState"
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/Subject"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "evidence",
        "room",
        "bed",
        "floor",
        "attention",
        "map",
        "sensor"
      ]
    },
    "SchemaId": {
      "description": "Which schema a message carries.",
      "type": "string",
      "enum": [
        "calipso.scene.v3",
        "calipso.events.v3"
      ]
    },
    "SenseProfile": {
      "description": "The model and thresholds of a sense.",
      "type": "object",
      "properties": {
        "backend_confidence": {
          "description": "Below this score the backend does not return the candidate.",
          "type": "number",
          "format": "float"
        },
        "kind": {
          "$ref": "#/$defs/LookKind"
        },
        "min_confidence": {
          "description": "Below this score the policy does not admit the candidate.",
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "model": {
          "description": "The model file, without its path.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "model",
        "backend_confidence"
      ]
    },
    "SensorState": {
      "description": "The reception state, as the shell reports it. It says nothing about the bed.",
      "type": "string",
      "enum": [
        "connecting",
        "streaming",
        "stalled",
        "reconnecting"
      ]
    },
    "SessionId": {
      "description": "Source session. Source time is only comparable within one session.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "SkipReason": {
      "description": "Why nothing was looked at (rule 12).",
      "oneOf": [
        {
          "description": "This sense was not requested.",
          "type": "string",
          "const": "not_requested"
        },
        {
          "description": "No body and no delimited headboard: nowhere to look for faces.",
          "type": "string",
          "const": "no_face_region"
        },
        {
          "description": "This loss was already reinforced: once per loss.",
          "type": "string",
          "const": "latch_spent"
        },
        {
          "description": "Nobody was seen in bed: there is no loss to reinforce.",
          "type": "string",
          "const": "no_subject_in_bed"
        },
        {
          "description": "The geometry does not apply: where the bed is, is unknown.",
          "type": "string",
          "const": "no_bed_geometry"
        },
        {
          "description": "The subject did not move since the last pose: the previous one holds.",
          "type": "string",
          "const": "subject_still"
        },
        {
          "description": "The subject is retained, not seen in this sample.",
          "type": "string",
          "const": "no_current_subject"
        },
        {
          "description": "Without a pose there are no points to measure depth at.",
          "type": "string",
          "const": "no_pose"
        },
        {
          "description": "Someone is in the room: a person is not learned as the bed.",
          "type": "string",
          "const": "room_occupied"
        },
        {
          "description": "Faces are in sight: someone may be covering the bed.",
          "type": "string",
          "const": "faces_present"
        },
        {
          "description": "The last attempt failed and the retry delay has not passed yet.",
          "type": "string",
          "const": "retry_wait"
        }
      ]
    },
    "Source": {
      "description": "Identity of the publishing shell; the core does not build these values.",
      "type": "object",
      "properties": {
        "build": {
          "$ref": "#/$defs/Build"
        },
        "camera": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "site": {
          "type": "string"
        }
      },
      "required": [
        "site",
        "camera",
        "run_id",
        "build"
      ]
    },
    "SourceSecs": {
      "description": "Seconds of source time (video PTS) within a session.",
      "type": "number",
      "format": "double"
    },
    "Subject": {
      "description": "The subject: the room's only occupant, if there is exactly one.",
      "type": "object",
      "properties": {
        "bbox": {
          "$ref": "#/$defs/Rect"
        },
        "confidence": {
          "type": "number",
          "format": "float"
        },
        "depth": {
          "anyOf": [
            {
              "$ref": "#/$defs/SubjectDepth"
            },
            {
              "type": "null"
            }
          ]
        },
        "lying": {
          "description": "Second level: absent without a pose or without bed geometry.",
          "anyOf": [
            {
              "$ref": "#/$defs/Lying"
            },
            {
              "type": "null"
            }
          ]
        },
        "pose": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pose"
            },
            {
              "type": "null"
            }
          ]
        },
        "posture": {
          "description": "Second level: absent without a pose or without per-point depth.",
          "anyOf": [
            {
              "$ref": "#/$defs/Posture"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "zone": {
          "$ref": "#/$defs/Zone"
        }
      },
      "required": [
        "zone",
        "bbox",
        "confidence",
        "provenance"
      ]
    },
    "SubjectDepth": {
      "description": "The subject's depth (the median of its measured points), with its own\nprovenance. Kept for compatibility.",
      "type": "object",
      "properties": {
        "meters": {
          "type": "number",
          "format": "float"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "meters",
        "provenance"
      ]
    },
    "Timing": {
      "type": "object",
      "properties": {
        "processing_ms": {
          "type": "number",
          "format": "double"
        },
        "wait_ms": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "wait_ms",
        "processing_ms"
      ]
    },
    "Zone": {
      "description": "The zones of the room.",
      "oneOf": [
        {
          "description": "The delimited bed.",
          "type": "string",
          "const": "bed"
        },
        {
          "description": "The rest of the room.",
          "type": "string",
          "const": "floor"
        }
      ]
    }
  }
}
